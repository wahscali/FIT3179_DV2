{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "In 2016, one in three inner-city workers commuted by public transport;",
      "on the fringe it was fewer than one in ten"
    ],
    "subtitle": [
      "Share of people travelling to work who used train, tram, bus or ferry,",
      "by SA3 (Statistical Area 3). Census 2016."
    ]
  },
  "width": 520,
  "height": 460,
  "data": {
    "url": "data/melb_sa3_pt.topojson",
    "format": {
      "type": "topojson",
      "feature": "melb_sa3"
    }
  },
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.7
  },
  "encoding": {
    "color": {
      "field": "properties.pt_share",
      "type": "quantitative",
      "scale": {
        "scheme": "purples",
        "domain": [
          0,
          0.4
        ]
      },
      "legend": {
        "title": [
          "Public transport",
          "share"
        ],
        "format": ".0%",
        "orient": "right"
      }
    },
    "tooltip": [
      {
        "field": "properties.sa3_name_2016",
        "title": "Area (SA3)"
      },
      {
        "field": "properties.pt_share",
        "type": "quantitative",
        "format": ".0%",
        "title": "Public transport share"
      },
      {
        "field": "properties.pt_commuters",
        "type": "quantitative",
        "format": ",",
        "title": "Public transport commuters"
      },
      {
        "field": "properties.travelled_to_work",
        "type": "quantitative",
        "format": ",",
        "title": "All who travelled to work"
      }
    ]
  }
}