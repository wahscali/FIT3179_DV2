{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Metropolitan patronage by mode, indexed to 2019",
    "subtitle": "Monthly patronage as a percentage of each mode's 2019 monthly average"
  },
  "width": 600,
  "height": 300,
  "data": {
    "url": "data/monthly_mode.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Month": "number",
        "Metropolitan train": "number",
        "Metropolitan tram": "number",
        "Metropolitan bus": "number"
      }
    }
  },
  "transform": [
    {"filter": "datum.Year >= 2018"},
    {"fold": ["Metropolitan train", "Metropolitan tram", "Metropolitan bus"], "as": ["mode", "pax"]},
    {"calculate": "datetime(datum.Year, datum.Month - 1, 1)", "as": "date"},
    {"calculate": "datum.Year == 2019 ? datum.pax : null", "as": "base"},
    {"joinaggregate": [{"op": "mean", "field": "base", "as": "base2019"}], "groupby": ["mode"]},
    {"calculate": "datum.pax / datum.base2019 * 100", "as": "index"}
  ],
  "layer": [
    {
      "data": {"values": [{}]},
      "mark": {"type": "rule", "strokeDash": [4, 4], "color": "#888"},
      "encoding": {"y": {"datum": 100}}
    },
    {
      "mark": {"type": "line", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": null, "axis": {"format": "%Y"}},
        "y": {"field": "index", "type": "quantitative", "title": "Index (2019 = 100)"},
        "color": {
          "field": "mode",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Metropolitan train", "Metropolitan tram", "Metropolitan bus"],
            "range": ["#0072CE", "#78BE20", "#FF8200"]
          }
        },
        "tooltip": [
          {"field": "mode", "type": "nominal", "title": "Mode"},
          {"field": "date", "type": "temporal", "format": "%b %Y", "title": "Month"},
          {"field": "index", "type": "quantitative", "format": ".0f", "title": "Index"},
          {"field": "pax", "type": "quantitative", "format": ",", "title": "Patronage"}
        ]
      }
    }
  ]
}