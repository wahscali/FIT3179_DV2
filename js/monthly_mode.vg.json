{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Every metropolitan mode is still below its 2019 average",
    "subtitle": [
      "Monthly boardings in millions, January 2018 to June 2026.",
      "Dashed lines: each mode's 2019 monthly average.",
      "Drag the lower strip to zoom. Click the legend to isolate a mode."
    ]
  },
  "data": {
    "url": "data/monthly_mode.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Month": "number",
        "Metropolitan train": "number",
        "Metropolitan tram": "number",
        "Metropolitan bus": "number"
      }
    }
  },
  "transform": [
    {"filter": "datum.Year >= 2018"},
    {"fold": ["Metropolitan train", "Metropolitan tram", "Metropolitan bus"], "as": ["mode", "pax"]},
    {"calculate": "datetime(datum.Year, datum.Month - 1, 1)", "as": "date"},
    {"calculate": "datum.pax / 1000000", "as": "pax_m"},
    {"calculate": "datum.mode == 'Metropolitan train' ? 'Train' : datum.mode == 'Metropolitan tram' ? 'Tram' : 'Bus'", "as": "mode_label"}
  ],
  "resolve": {"legend": {"color": "independent"}},
  "vconcat": [
    {
      "name": "main",
      "width": 720,
      "height": 300,
      "encoding": {
        "color": {
          "field": "mode_label",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["Train", "Tram", "Bus"], "range": ["#0072CE", "#78BE20", "#FF8200"]},
          "legend": {"orient": "top", "direction": "horizontal"}
        }
      },
      "layer": [
        {
          "data": {"values": [{"s": "2020-03-30", "e": "2021-10-22"}]},
          "mark": {"type": "rect", "opacity": 0.07, "clip": true},
          "encoding": {"x": {"field": "s", "type": "temporal", "scale": {"domain": {"param": "brush"}}}, "x2": {"field": "e"}, "color": {"value": "#13315c"}}
        },
        {
          "data": {"values": [{"d": "2020-04-10", "y": 24.2, "t": "Lockdowns, 2020 to 2021", "w": "bold"}, {"d": "2020-08-01", "y": 18.3, "t": "Aug 2020: trains carried 9%", "w": "normal"}, {"d": "2020-08-01", "y": 17.1, "t": "of a normal 2019 month", "w": "normal"}]},
          "mark": {"type": "text", "align": "left", "dx": 5, "clip": true, "fontWeight": {"expr": "datum.w"}},
          "encoding": {"x": {"field": "d", "type": "temporal"}, "y": {"field": "y", "type": "quantitative"}, "text": {"field": "t"}, "color": {"value": "#13315c"}}
        },
        {
          "data": {"values": [{"d": "2020-08-01", "y": 2.4, "y2": 18.8}]},
          "mark": {"type": "rule", "strokeWidth": 1, "clip": true},
          "encoding": {"x": {"field": "d", "type": "temporal"}, "y": {"field": "y", "type": "quantitative"}, "y2": {"field": "y2"}, "color": {"value": "#13315c"}}
        },
        {
          "params": [{"name": "mode_pick", "select": {"type": "point", "fields": ["mode_label"]}, "bind": "legend"}],
          "mark": {"type": "line", "strokeWidth": 2, "clip": true},
          "encoding": {
            "x": {"field": "date", "type": "temporal", "title": null, "axis": {"format": "%b %Y"}, "scale": {"domain": {"param": "brush"}}},
            "y": {"field": "pax_m", "type": "quantitative", "title": "Monthly patronage (millions)"},
            "opacity": {"condition": {"param": "mode_pick", "value": 1}, "value": 0.15}
          }
        },
        {
          "transform": [
            {"filter": "datum.Year == 2019"},
            {"aggregate": [{"op": "mean", "field": "pax_m", "as": "avg2019"}], "groupby": ["mode_label"]}
          ],
          "mark": {"type": "rule", "strokeDash": [4, 4]},
          "encoding": {
            "y": {"field": "avg2019", "type": "quantitative"},
            "opacity": {"condition": {"param": "mode_pick", "value": 0.6}, "value": 0.15}
          }
        },
        {
          "transform": [{"pivot": "mode_label", "value": "pax", "groupby": ["date"]}],
          "params": [
            {"name": "hover", "select": {"type": "point", "fields": ["date"], "nearest": true, "on": "pointerover", "clear": "pointerout"}}
          ],
          "mark": {"type": "rule", "clip": true},
          "encoding": {
            "x": {"field": "date", "type": "temporal", "scale": {"domain": {"param": "brush"}}},
            "color": {"value": "#888888"},
            "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
            "tooltip": [
              {"field": "date", "type": "temporal", "format": "%b %Y", "title": "Month"},
              {"field": "Train", "type": "quantitative", "format": ","},
              {"field": "Tram", "type": "quantitative", "format": ","},
              {"field": "Bus", "type": "quantitative", "format": ","}
            ]
          }
        }
      ]
    },
    {
      "name": "overview",
      "width": 720,
      "height": 60,
      "params": [{"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "line", "strokeWidth": 1},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": null, "axis": {"format": "%Y", "tickCount": "year"}},
        "y": {"field": "pax_m", "type": "quantitative", "title": null, "axis": {"tickCount": 2, "grid": false}},
        "color": {"field": "mode_label", "type": "nominal", "legend": null}
      }
    }
  ]
}
